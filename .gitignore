build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
devtools_options.yaml
*.log

# Note: pubspec.lock is intentionally NOT ignored.
# This is an app, not a library - the lockfile must be committed.

# IDE
.idea/
android/.idea/
*.iml
.vscode/

# iOS
ios/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/
**/xcuserdata/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Android
android/.gradle/
android/local.properties
android/key.properties
*.jks

# Node (firebase/functions)
node_modules/

# Firebase local artifacts
.firebase/
*-debug.log
firestore-debug.log
ui-debug.log

# Secrets - never commit these
*serviceAccount*.json
serviceAccountKey.json
.env
.env.*
# APNs auth key (docs/fcm-push-plan.md, Step 5). Signs pushes for the entire
# Apple team - every app, no expiry, cannot be scoped down. Unlike a SHA-1
# fingerprint (public, and already in google-services.json) this is a real
# credential. Upload it to Firebase console, never into the repo.
*.p8

# Deliberately NOT ignoring google-services.json / GoogleService-Info.plist.
# They are client identifiers that ship inside every binary, not secrets, and
# the build needs them. android/app/src/debug/google-services.json was lost
# because it was never tracked, which is why debug builds now hit production.
# Track them so git can restore them. The real exposure is firestore.rules.
*.json.bak

# Tooling
graphify-out/
# Not the whole .claude directory: .claude/skills/ is shared tooling and belongs
# in the repo. Only the per-machine permission allowlist stays out.
.claude/settings.local.json
._bmad
._bmad.*
logs/
temp/
bmad/

# OS
.DS_Store
Thumbs.db
